# ==============================================================================
# CRM Colucci Imóveis — Variáveis de Ambiente (.env.example)
# ==============================================================================
# ATENÇÃO: NUNCA insira chaves reais neste arquivo ou comite arquivos .env locais.
# Copie este arquivo para .env.local e preencha os valores para desenvolvimento.

# ------------------------------------------------------------------------------
# 1. Supabase (Banco de Dados & Autenticação)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key-aqui"
SUPABASE_SECRET_KEY="sua-service-role-secret-key-aqui"

# ------------------------------------------------------------------------------
# 2. Segurança e Cron Jobs (Vercel Crons & Rotas de Sistema)
# ------------------------------------------------------------------------------
CRON_SECRET="segredo-forte-para-rotas-de-cron-e-admin"
ENCRYPTION_KEY="chave-hex-32-bytes-para-criptografia-aes"

# ------------------------------------------------------------------------------
# 3. Evolution API (WhatsApp Gateway)
# ------------------------------------------------------------------------------
EVOLUTION_API_URL="https://sua-evolution-api.com"
EVOLUTION_API_KEY="sua-evolution-api-key"
EVOLUTION_API_KEY_2=""
WHATSAPP_WEBHOOK_SECRET="segredo-para-validar-webhook-evolution"

# Notificações e roteamento WhatsApp
WHATSAPP_NOTIFY_INSTANCE="nome-da-instancia-do-gestor"
WHATSAPP_NOTIFY_NUMBER="5518999999999"
WHATSAPP_NOTIFY_GROUP=""
WHATSAPP_NOTIFY_NEGOCIO_EXTRA=""
WHATSAPP_MANUAL_PIPELINE_INSTANCES=""
WHATSAPP_BLOCKED_NUMBERS=""
WHATSAPP_BLOCKED_NAMES=""
WHATSAPP_TEST_NUMBER=""

# ------------------------------------------------------------------------------
# 4. Provedores de Inteligência Artificial (LLMs & Áudio)
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""
CLAUDE_API_KEY=""

# ------------------------------------------------------------------------------
# 5. Meta Ads & Conversions API (CAPI)
# ------------------------------------------------------------------------------
META_APP_ID=""
META_APP_SECRET=""
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID="act_..."
META_API_VERSION="v21.0"
META_PIXEL_ID=""
META_CAPI_TOKEN=""
FACEBOOK_PAGE_ACCESS_TOKEN=""

# ------------------------------------------------------------------------------
# 6. Aplicação Pública & Rastreamento
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MASTER_EMAIL="gestao@colucciimoveis.com.br"
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_WHATSAPP_NUMERO=""
